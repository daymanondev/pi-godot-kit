;
; Cozy Character Scaffold — prototype for pi-godot-kit (#4)
;
config_version=5

[application]

config/name="Cozy Character Scaffold"
config/description="Prototype scaffold: CharacterBody2D + AnimatedSprite2D (from pack_spritesheet.py JSON) + input controller"
run/main_scene="res://scenes/play.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

InputSetup="*res://scripts/input_setup.gd"

[display]

window/size/viewport_width=480
window/size/viewport_height=270
window/stretch/mode="canvas_items"

[physics]

2d/default_gravity=980

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"

[rendering]

environment/defaults/default_clear_color = Color(0.49, 0.61, 0.42, 1)
